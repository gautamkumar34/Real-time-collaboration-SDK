# ─── Supabase Auth ───────────────────────────────
# Required for verifying Supabase user session tokens (ES256).
# Set to your project URL, e.g. https://xyzproject.supabase.co
SUPABASE_URL=

# Legacy HMAC secret (only needed for custom HS256 tokens, not Supabase user tokens)
SUPABASE_SECRET_KEY=
JWT_SECRET=

# ─── Core ────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# Comma-separated origins. MUST be set in production (not "*").
CORS_ORIGIN=*

# ─── Store Backend ───────────────────────────────
# "memory" = in-memory (dev/test, no persistence)
# "postgres" = PostgreSQL (production, survives crashes)
STORE_BACKEND=memory

# ─── PostgreSQL ──────────────────────────────────
# Required when STORE_BACKEND=postgres
DATABASE_URL=postgresql://collabdoc:collabdoc@localhost:5432/collabdoc
PG_POOL_SIZE=10

# ─── Redis ───────────────────────────────────────
# Used for multi-instance broadcast (Socket.IO Redis adapter)
# Only active when STORE_BACKEND=postgres
REDIS_URL=redis://localhost:6379

# ─── Snapshots ───────────────────────────────────
# Snapshot triggers (whichever fires first)
SNAPSHOT_EVERY_N_OPS=100
SNAPSHOT_AFTER_SECONDS=30
