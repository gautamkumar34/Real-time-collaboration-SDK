{
  "name": "collabdoc-sdk",
  "version": "1.0.0",
  "description": "Real-time collaborative document editing SDK powered by Yjs CRDTs and Socket.IO. Add Google Docs-style collaboration to any React app in minutes.",
  "author": "Gautam Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gautamkumar34/Real-time-collaboration-SDK"
  },
  "homepage": "https://collabdocsdk.vercel.app",
  "keywords": [
    "collaboration",
    "realtime",
    "crdt",
    "yjs",
    "socket.io",
    "collaborative-editing",
    "react",
    "multiplayer",
    "document-editing",
    "sdk"
  ],
  "main": "./dist/collabdoc-sdk.cjs.js",
  "module": "./dist/collabdoc-sdk.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/collabdoc-sdk.es.js",
      "require": "./dist/collabdoc-sdk.cjs.js"
    },
    "./react": {
      "types": "./dist/react/useCollabDoc.d.ts",
      "import": "./dist/react.es.js",
      "require": "./dist/react.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.19",
    "@types/react": "^19.2.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
